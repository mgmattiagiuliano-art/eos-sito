# Copia in .env e personalizza. Nessuna variabile è obbligatoria per `npm run dev`.

# URL pubblico del sito (canonical, sitemap, og:image assoluta). Senza slash finale.
PUBLIC_SITE_URL=https://www.eosimpianti.it

# Backend dei form: local | netlify | endpoint
#  - local    → nessun invio: log in console + salvataggio in localStorage (sviluppo/test)
#  - netlify  → Netlify Forms (POST a "/" con form-name)
#  - endpoint → POST multipart a PUBLIC_FORMS_ENDPOINT (Formspree, Getform, backend proprio)
PUBLIC_FORMS_PROVIDER=local

# Solo con PUBLIC_FORMS_PROVIDER=endpoint
PUBLIC_FORMS_ENDPOINT=

# Solo sviluppo: con "true" il provider local fallisce sempre (per provare i messaggi d'errore)
PUBLIC_FORMS_SIMULATE_ERROR=false

# Password dei parametri avanzati del calcolatore (default "admin").
# Il controllo è solo lato browser: evita modifiche accidentali, non è una protezione di sicurezza.
PUBLIC_EOSOLAR_ADMIN_PASSWORD=
