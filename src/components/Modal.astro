---
/**
 * Modale accessibile basata su <dialog> nativo + showModal():
 * il resto della pagina diventa inerte (focus trap), Esc chiude, aria-modal implicito.
 * Apertura: qualsiasi elemento con data-modal-open="<id>" oppure openModal(id) da script.
 */
interface Props {
  id: string;
  title: string;
  /** Classe aggiuntiva sulla card. */
  class?: string;
}
const { id, title, class: className } = Astro.props;
const titleId = `${id}-title`;
---

<dialog id={id} class="modal" aria-labelledby={titleId} data-modal>
  <div class:list={['modal__card', className]}>
    <button type="button" class="modal__close" data-modal-close aria-label="Chiudi">
      <span aria-hidden="true">&times;</span>
    </button>
    <h2 id={titleId} class="modal__title">{title}</h2>
    <slot />
  </div>
</dialog>

<style>
  .modal {
    width: min(100% - 32px, 460px);
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    border: none;
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    color: var(--c-text);
    box-shadow: var(--shadow-lg);
    overflow: auto;
  }

  .modal::backdrop {
    background: rgb(15 23 42 / 0.85);
    backdrop-filter: blur(6px);
  }

  .modal__card {
    position: relative;
    padding: 36px 28px 28px;
    border-top: 6px solid var(--c-red);
  }

  .modal__title {
    font-size: 1.35rem;
    margin-bottom: 8px;
    padding-right: 32px;
  }

  .modal__close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: none;
    border-radius: 50%;
    background: none;
    font-size: 1.8rem;
    line-height: 1;
    color: var(--c-text);
  }

  .modal__close:hover {
    background: var(--c-bg);
    color: var(--c-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .modal[open] {
      animation: modal-in 0.25s ease;
    }

    @keyframes modal-in {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
    }
  }
</style>

<script>
  import { initModals } from '../lib/ui/dialog';
  initModals();
</script>
