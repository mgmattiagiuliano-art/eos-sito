---
// TODO(EOS): confermare "20+ anni di esperienza" (ripreso dal prototipo).
// Dato sulla sicurezza fornito da EOS (fonte INAIL), 9/11/2026.
const features: { value: string; title: string; text: string; source?: string }[] = [
  { value: '20+', title: 'Anni di esperienza', text: 'Competenza consolidata nel settore civile e industriale.' },
  { value: '100%', title: 'Su misura', text: "Progetti nati dall'analisi dei consumi reali." },
  { value: '1', title: 'Unico referente', text: 'Dalla prima consulenza alla manutenzione nel tempo.' },
  {
    value: '0',
    title: 'Infortuni negli ultimi 3 anni',
    text: 'La sicurezza dei nostri tecnici e dei cantieri viene prima di tutto.',
    source: 'Fonte: INAIL',
  },
  { value: 'AL · GE', title: 'Radicamento e operatività', text: 'Radicati tra Alessandria e Genova, operativi su tutto il territorio nazionale.' },
];
---

<section class="section container" id="perche-eos" aria-labelledby="perche-title">
  <div class="box reveal">
    <div class="section-head">
      <h2 id="perche-title">Perché scegliere <span class="spark">EOS Impianti</span></h2>
      <p>Un unico referente per trasformare le tue esigenze in soluzioni affidabili e durature.</p>
    </div>
    <ul class="features" role="list">
      {
        features.map((f) => (
          <li>
            <p class="features__value">{f.value}</p>
            <h3 class="features__title">{f.title}</h3>
            <p class="features__text">{f.text}</p>
            {f.source && <p class="features__source">{f.source}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* 5 voci: una riga su desktop; su schermi stretti l'ultima riga resta centrata */
  .features {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    text-align: center;
  }

  .features > li {
    flex: 1 1 170px;
    max-width: 230px;
  }

  .features__value {
    margin-bottom: 4px;
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 900;
    color: var(--c-blue);
  }

  .features__title {
    margin-bottom: 4px;
    font-size: 1rem;
    font-weight: 700;
  }

  .features__text {
    font-size: 0.88rem;
  }

  .features__source {
    margin-top: 4px;
    font-size: 0.75rem;
    font-style: italic;
    color: var(--c-text-muted);
  }
</style>
