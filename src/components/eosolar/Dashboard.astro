---
import { DEFAULT_CONSUMI, DEFAULT_COSTI, DEFAULT_PARAMS, MESI, OPZIONI_FLESSIBILITA, RANGE } from '../../lib/eosolar/defaults';
import { fmtInt } from '../../lib/eosolar/format';
import { ADVANCED_FIELDS, MAIN_FIELDS, displayValue, type ParamField } from './fields';

const tabs = [
  { id: 'input', label: 'Dati e consumi' },
  { id: 'ottimale', label: 'Dimensionamento ottimale' },
  { id: 'manuale', label: 'Simulazione libera' },
] as const;

const p = DEFAULT_PARAMS;
const fieldId = (f: ParamField) => `eosolar-p-${f.key}`;
---

<div class="eosolar-dashboard" data-eosolar-dashboard hidden>
  <div class="eosolar-tabs" role="tablist" aria-label="Sezioni del calcolatore">
    {
      tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          class="eosolar-tab"
          id={`eosolar-tab-${t.id}`}
          aria-controls={`eosolar-panel-${t.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tab={t.id}
        >
          <span aria-hidden="true">{i + 1}</span> {t.label}
        </button>
      ))
    }
  </div>

  <!-- ============ TAB 1: INPUT ============ -->
  <div role="tabpanel" id="eosolar-panel-input" aria-labelledby="eosolar-tab-input" data-panel="input" tabindex="0">
    <form class="eosolar-form" data-eosolar-form novalidate>
      <fieldset class="eosolar-card">
        <legend class="eosolar-card__title">Fabbisogno energetico</legend>
        <div class="eosolar-grid-2">
          <div class="eosolar-field">
            <label for="eosolar-consumo">Consumo totale annuo (kWh)</label>
            <input id="eosolar-consumo" type="number" inputmode="decimal" min="0" step="10" value={DEFAULT_CONSUMI.consumoAnnuo} data-consumo-annuo />
          </div>
          <div class="eosolar-field">
            <label for="eosolar-flex">Consumi spostabili di giorno</label>
            <select id="eosolar-flex" data-flessibilita>
              {OPZIONI_FLESSIBILITA.map((o) => <option value={o.value} selected={o.value === DEFAULT_CONSUMI.flessibilita}>{o.label}</option>)}
            </select>
          </div>
        </div>

        <fieldset class="eosolar-subset">
          <legend>Consumi diurni mensili in fascia F1 (kWh)</legend>
          <div class="eosolar-grid-12">
            {
              MESI.map((m, i) => (
                <div class="eosolar-field eosolar-field--sm">
                  <label for={`eosolar-f1-${i}`}>{m}</label>
                  <input id={`eosolar-f1-${i}`} type="number" inputmode="decimal" min="0" step="1" value={DEFAULT_CONSUMI.consumiF1[i]} data-f1={i} />
                </div>
              ))
            }
          </div>
          <p class="eosolar-summary" data-f2f3-summary aria-live="polite"></p>
        </fieldset>
      </fieldset>

      <fieldset class="eosolar-card">
        <legend class="eosolar-card__title">Produzione: ore equivalenti mensili (kWh per kWp)</legend>
        <p class="eosolar-card__sub">Valori medi per il basso Piemonte. Un tecnico EOS li verifica in base a orientamento e ombreggiamenti.</p>
        <div class="eosolar-grid-12">
          {
            MESI.map((m, i) => (
              <div class="eosolar-field eosolar-field--sm">
                <label for={`eosolar-ore-${i}`}>{m}</label>
                <input id={`eosolar-ore-${i}`} type="number" inputmode="decimal" min="0" step="1" value={DEFAULT_CONSUMI.oreEquivalenti[i]} data-ore={i} />
              </div>
            ))
          }
        </div>
      </fieldset>

      <section class="eosolar-card" aria-labelledby="eosolar-costi-title">
        <h3 id="eosolar-costi-title" class="eosolar-card__title">Costi di riferimento</h3>
        <p class="eosolar-card__sub">Costi chiavi in mano medi, IVA esclusa, interpolati sulla taglia scelta.</p>
        <div class="eosolar-grid-2">
          <div class="eosolar-table-wrap">
            <table class="eosolar-table">
              <caption class="visually-hidden">Costo dell'impianto fotovoltaico per taglia</caption>
              <thead><tr><th scope="col">Taglia FV</th><th scope="col" class="num">€/kWp</th></tr></thead>
              <tbody>{DEFAULT_COSTI.fv.map((c) => <tr><td>{c.size} kWp</td><td class="num">{fmtInt(c.unitCost)} €</td></tr>)}</tbody>
            </table>
          </div>
          <div class="eosolar-table-wrap">
            <table class="eosolar-table">
              <caption class="visually-hidden">Costo della batteria per capacità</caption>
              <thead><tr><th scope="col">Batteria</th><th scope="col" class="num">€/kWh utile</th></tr></thead>
              <tbody>{DEFAULT_COSTI.batteria.map((c) => <tr><td>{String(c.size).replace('.', ',')} kWh</td><td class="num">{fmtInt(c.unitCost)} €</td></tr>)}</tbody>
            </table>
          </div>
        </div>
      </section>

      <fieldset class="eosolar-card">
        <legend class="eosolar-card__title">Parametri economici</legend>
        <div class="eosolar-params">
          {
            MAIN_FIELDS.map((f) => (
              <div class="eosolar-field">
                <label for={fieldId(f)}>{f.label} ({f.unit})</label>
                <input id={fieldId(f)} type="number" inputmode="decimal" step={f.step} min={f.min} max={f.max} value={displayValue(f)} data-param={f.key} data-scale={f.scale} />
              </div>
            ))
          }
        </div>

        <details class="eosolar-details">
          <summary>Parametri avanzati</summary>
          <div class="eosolar-params">
            {
              ADVANCED_FIELDS.map((f) => (
                <div class="eosolar-field">
                  <label for={fieldId(f)}>{f.label} ({f.unit})</label>
                  <input id={fieldId(f)} type="number" inputmode="decimal" step={f.step} min={f.min} max={f.max} value={displayValue(f)} data-param={f.key} data-scale={f.scale} />
                </div>
              ))
            }
          </div>
        </details>

        <details class="eosolar-details">
          <summary>Vendita energia e agevolazioni fiscali (disattivate)</summary>
          <!-- TODO(EOS): verificare normativa vigente; i default restano disattivati finché non confermati. -->
          <p class="eosolar-card__sub">
            Opzioni disattivate di default: attivale solo con valori verificati sulla normativa vigente.
          </p>
          <div class="eosolar-params">
            <div class="eosolar-toggle">
              <div class="eosolar-check">
                <input id="eosolar-rid-on" type="checkbox" data-toggle="ritiroDedicato" checked={p.ritiroDedicato.attivo} />
                <label for="eosolar-rid-on">Valorizza l'energia immessa (ritiro dedicato)</label>
              </div>
              <div class="eosolar-field">
                <label for="eosolar-rid-prezzo">Prezzo energia immessa (€/kWh)</label>
                <input id="eosolar-rid-prezzo" type="number" inputmode="decimal" step="0.01" min="0" value={p.ritiroDedicato.prezzo} data-toggle-value="ritiroDedicato.prezzo" data-scale="1" />
              </div>
            </div>
            <div class="eosolar-toggle">
              <div class="eosolar-check">
                <input id="eosolar-iva-on" type="checkbox" data-toggle="iva" checked={p.iva.attivo} />
                <label for="eosolar-iva-on">Applica l'IVA a investimento e costi</label>
              </div>
              <div class="eosolar-field">
                <label for="eosolar-iva-aliquota">Aliquota IVA (%)</label>
                <input id="eosolar-iva-aliquota" type="number" inputmode="decimal" step="1" min="0" max="100" value={p.iva.aliquota * 100} data-toggle-value="iva.aliquota" data-scale="0.01" />
              </div>
            </div>
            <div class="eosolar-toggle">
              <div class="eosolar-check">
                <input id="eosolar-detr-on" type="checkbox" data-toggle="detrazione" checked={p.detrazione.attivo} />
                <label for="eosolar-detr-on">Considera una detrazione fiscale</label>
              </div>
              <div class="eosolar-field">
                <label for="eosolar-detr-aliquota">Aliquota detrazione (%)</label>
                <input id="eosolar-detr-aliquota" type="number" inputmode="decimal" step="1" min="0" max="100" value={p.detrazione.aliquota * 100} data-toggle-value="detrazione.aliquota" data-scale="0.01" />
              </div>
              <div class="eosolar-field">
                <label for="eosolar-detr-anni">Anni di recupero</label>
                <input id="eosolar-detr-anni" type="number" inputmode="numeric" step="1" min="1" max="25" value={p.detrazione.anni} data-toggle-value="detrazione.anni" data-scale="1" />
              </div>
            </div>
          </div>
        </details>
      </fieldset>

      <div class="eosolar-alert eosolar-alert--error" role="alert" data-input-errors hidden>
        <p><strong>Controlla i dati inseriti:</strong></p>
        <ul data-input-errors-list></ul>
      </div>

      <button type="submit" class="btn btn--primary btn--block">Calcola il dimensionamento ottimale</button>
    </form>
  </div>

  <!-- ============ TAB 2: OTTIMALE ============ -->
  <div role="tabpanel" id="eosolar-panel-ottimale" aria-labelledby="eosolar-tab-ottimale" data-panel="ottimale" tabindex="0" hidden>
    <div class="eosolar-hero" aria-live="polite">
      <p class="eosolar-hero__badge">Configurazione consigliata</p>
      <p class="eosolar-hero__value" data-out="config">—</p>
      <p class="eosolar-hero__text" data-out="statement">Inserisci i dati e avvia il calcolo.</p>
    </div>

    <div class="eosolar-alert eosolar-alert--warn" data-out="warnings" hidden>
      <ul data-out="warnings-list"></ul>
    </div>

    <section class="eosolar-card" aria-labelledby="eosolar-kpi-title">
      <h3 id="eosolar-kpi-title" class="eosolar-card__title">Indicatori principali</h3>
      <div class="eosolar-metrics" data-out="metrics"></div>
    </section>

    <section class="eosolar-card" aria-labelledby="eosolar-top-title">
      <h3 id="eosolar-top-title" class="eosolar-card__title">Migliori configurazioni</h3>
      <p class="eosolar-card__sub" data-out="criterio"></p>
      <div class="eosolar-table-wrap">
        <table class="eosolar-table">
          <thead>
            <tr><th scope="col">#</th><th scope="col">Configurazione</th><th scope="col" class="num">Investimento</th><th scope="col" class="num">NPV</th><th scope="col" class="num">Payback att.</th><th scope="col" class="num">MIRR</th><th scope="col" class="num">Copertura</th></tr>
          </thead>
          <tbody data-out="top"></tbody>
        </table>
      </div>
    </section>

    <section class="eosolar-card" aria-labelledby="eosolar-sens-title">
      <h3 id="eosolar-sens-title" class="eosolar-card__title">Analisi di sensibilità</h3>
      <p class="eosolar-card__sub">Ogni scenario varia insieme prezzo dell'energia, inflazione energetica e produttività dell'impianto.</p>
      <div class="eosolar-table-wrap">
        <table class="eosolar-table">
          <thead>
            <tr><th scope="col">Scenario</th><th scope="col" class="num">Prezzo energia</th><th scope="col" class="num">Inflazione energetica</th><th scope="col" class="num">Produttività</th><th scope="col" class="num">Payback att.</th><th scope="col" class="num">NPV</th></tr>
          </thead>
          <tbody data-out="sens"></tbody>
        </table>
      </div>
    </section>

    <div class="eosolar-charts">
      <figure class="eosolar-chart">
        <figcaption>Produzione e consumi mensili (anno 1)</figcaption>
        <div class="eosolar-chart__box"><canvas data-chart="bars-opt" role="img" aria-label="Grafico a barre di produzione, consumo e autoconsumo mensili"></canvas></div>
      </figure>
      <figure class="eosolar-chart">
        <figcaption>NPV al variare della potenza</figcaption>
        <div class="eosolar-chart__box"><canvas data-chart="npv-curve" role="img" aria-label="Curva del valore attuale netto in funzione dei kWp"></canvas></div>
      </figure>
    </div>
    <figure class="eosolar-chart">
      <figcaption>Flusso di cassa cumulato attualizzato</figcaption>
      <div class="eosolar-chart__box"><canvas data-chart="cash-opt" role="img" aria-label="Grafico del flusso di cassa cumulato attualizzato negli anni"></canvas></div>
    </figure>

    <p class="eosolar-disclaimer eosolar-disclaimer--block">
      <strong>Stima indicativa, non vincolante.</strong> Modello mensile semplificato con valori medi: la fascia F1 è
      approssimata ai consumi diurni, la batteria è simulata con un ciclo al giorno, prezzi e inflazione sono ipotesi.
      Il dimensionamento definitivo richiede il sopralluogo di un tecnico EOS.
    </p>
    <a class="btn btn--secondary" href="/#contatti">Richiedi un sopralluogo</a>
  </div>

  <!-- ============ TAB 3: MANUALE ============ -->
  <div role="tabpanel" id="eosolar-panel-manuale" aria-labelledby="eosolar-tab-manuale" data-panel="manuale" tabindex="0" hidden>
    <div class="eosolar-card">
      <h3 class="eosolar-card__title">Scegli potenza e accumulo</h3>
      <div class="eosolar-slider">
        <label for="eosolar-slider-kwp">Potenza fotovoltaico</label>
        <input id="eosolar-slider-kwp" type="range" min={RANGE.kwp.min} max={RANGE.kwp.max} step={RANGE.kwp.step} value="3" data-slider="kwp" aria-describedby="eosolar-slider-kwp-out" />
        <output id="eosolar-slider-kwp-out" class="num" for="eosolar-slider-kwp" data-slider-out="kwp">3,0 kWp</output>
      </div>
      <div class="eosolar-slider">
        <label for="eosolar-slider-kwh">Accumulo</label>
        <input id="eosolar-slider-kwh" type="range" min={RANGE.kwhBatteria.min} max={RANGE.kwhBatteria.max} step={RANGE.kwhBatteria.step} value="0" data-slider="kwh" aria-describedby="eosolar-slider-kwh-out" />
        <output id="eosolar-slider-kwh-out" class="num" for="eosolar-slider-kwh" data-slider-out="kwh">0,0 kWh</output>
      </div>
      <p class="eosolar-card__sub">I risultati si aggiornano mentre muovi i cursori, con i dati del primo tab.</p>
    </div>

    <div class="eosolar-alert eosolar-alert--warn" data-out="man-warnings" hidden>
      <ul data-out="man-warnings-list"></ul>
    </div>
    <div class="eosolar-metrics" data-out="man-metrics" aria-live="polite"></div>
    <div class="eosolar-charts">
      <figure class="eosolar-chart">
        <figcaption>Produzione e consumi mensili (anno 1)</figcaption>
        <div class="eosolar-chart__box"><canvas data-chart="bars-man" role="img" aria-label="Grafico a barre di produzione, consumo e autoconsumo mensili"></canvas></div>
      </figure>
      <figure class="eosolar-chart">
        <figcaption>Flusso di cassa cumulato attualizzato</figcaption>
        <div class="eosolar-chart__box"><canvas data-chart="cash-man" role="img" aria-label="Grafico del flusso di cassa cumulato attualizzato negli anni"></canvas></div>
      </figure>
    </div>
  </div>

  <!-- Template per i risultati: clonati e riempiti con textContent (niente innerHTML) -->
  <template data-tpl="metric">
    <div class="eosolar-metric">
      <p class="eosolar-metric__title" data-f="title"></p>
      <p class="eosolar-metric__value num" data-f="value"></p>
      <p class="eosolar-metric__desc" data-f="desc"></p>
    </div>
  </template>
  <template data-tpl="top-row">
    <tr>
      <td data-f="rank"></td><td data-f="config"></td><td class="num" data-f="capex"></td><td class="num" data-f="npv"></td>
      <td class="num" data-f="payback"></td><td class="num" data-f="mirr"></td><td class="num" data-f="ssr"></td>
    </tr>
  </template>
  <template data-tpl="sens-row">
    <tr>
      <th scope="row" data-f="scenario"></th><td class="num" data-f="tariffa"></td><td class="num" data-f="inflazione"></td>
      <td class="num" data-f="produttivita"></td><td class="num" data-f="payback"></td><td class="num" data-f="npv"></td>
    </tr>
  </template>
  <template data-tpl="li"><li data-f="text"></li></template>
</div>
