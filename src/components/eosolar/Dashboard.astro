---
import { DEFAULT_CONSUMI, DEFAULT_COSTI, DEFAULT_PARAMS, MESI, OPZIONI_FLESSIBILITA, RANGE } from '../../lib/eosolar/defaults';
import { fmtInt } from '../../lib/eosolar/format';
import { kwpGrid } from '../../lib/eosolar/optimizer';
import { ADVANCED_FIELDS, MAIN_FIELDS, displayValue, type ParamField } from './fields';
import Info from './Info.astro';
import ResultView from './ResultView.astro';

const tabs = [
  { id: 'input', label: 'Dati e consumi' },
  { id: 'ottimale', label: 'Dimensionamento ottimale' },
  { id: 'manuale', label: 'Simulazione libera' },
] as const;

const p = DEFAULT_PARAMS;
const fieldId = (f: ParamField) => `eosolar-p-${f.key}`;
const fmtSize = (n: number) => String(n).replace('.', ',');

// Slider della simulazione libera: indici sulle stesse griglie dell'ottimizzatore
const gridKwp = kwpGrid();
const gridKwh = RANGE.kwhBatteria;
const startKwp = Math.max(0, gridKwp.indexOf(3));

// Link esterno (nessuna risorsa caricata dalla pagina: nessun impatto GDPR)
const PVGIS_URL = 'https://re.jrc.ec.europa.eu/pvg_tools/en/';
---

<div class="eosolar-dashboard" data-eosolar-dashboard hidden>
  <div class="eosolar-tabs" role="tablist" aria-label="Sezioni del calcolatore">
    {
      tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          class="eosolar-tab"
          id={`eosolar-tab-${t.id}`}
          aria-controls={`eosolar-panel-${t.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tab={t.id}
        >
          <span aria-hidden="true">{i + 1}</span> {t.label}
        </button>
      ))
    }
  </div>

  <!-- ============ TAB 1: INPUT ============ -->
  <div role="tabpanel" id="eosolar-panel-input" aria-labelledby="eosolar-tab-input" data-panel="input" tabindex="0">
    <form class="eosolar-form" data-eosolar-form novalidate>
      <fieldset class="eosolar-card">
        <legend class="eosolar-card__title">Fabbisogno energetico</legend>
        <div class="eosolar-grid-2">
          <div class="eosolar-field">
            <div class="eosolar-field__head">
              <label for="eosolar-consumo">Consumo totale annuo (kWh)</label>
              <Info k="consumoAnnuo" label="Consumo totale annuo" />
            </div>
            <input id="eosolar-consumo" type="number" inputmode="decimal" min="0" step="10" value={DEFAULT_CONSUMI.consumoAnnuo} data-consumo-annuo />
          </div>
          <div class="eosolar-field">
            <div class="eosolar-field__head">
              <label for="eosolar-flex">Consumi spostabili di giorno</label>
              <Info k="flessibilita" label="Consumi spostabili di giorno" />
            </div>
            <select id="eosolar-flex" data-flessibilita>
              {OPZIONI_FLESSIBILITA.map((o) => <option value={o.value} selected={o.value === DEFAULT_CONSUMI.flessibilita}>{o.label}</option>)}
            </select>
          </div>
        </div>

        <fieldset class="eosolar-subset">
          <legend>
            Consumi diurni mensili in fascia F1 (kWh) <Info k="consumiF1" label="Consumi mensili in fascia F1" />
          </legend>
          <div class="eosolar-grid-12">
            {
              MESI.map((m, i) => (
                <div class="eosolar-field eosolar-field--sm">
                  <label for={`eosolar-f1-${i}`}>{m}</label>
                  <input id={`eosolar-f1-${i}`} type="number" inputmode="decimal" min="0" step="1" value={DEFAULT_CONSUMI.consumiF1[i]} data-f1={i} />
                </div>
              ))
            }
          </div>
          <p class="eosolar-summary" data-f2f3-summary aria-live="polite"></p>
        </fieldset>
      </fieldset>

      <fieldset class="eosolar-card">
        <legend class="eosolar-card__title">
          Produzione: ore equivalenti mensili (kWh per kWp) <Info k="oreEquivalenti" label="Ore equivalenti mensili" />
        </legend>
        <p class="eosolar-card__sub">
          Valori medi per il basso Piemonte. Per il tuo tetto puoi calcolarli con
          <a href={PVGIS_URL} target="_blank" rel="noopener noreferrer">PVGIS<span class="visually-hidden"> (si apre in una nuova scheda)</span></a>,
          lo strumento gratuito della Commissione europea: scegli "Grid connected", potenza 1 kWp, perdite 14%, la tua
          inclinazione e il tuo orientamento, poi riporta qui la produzione mensile (E_m).
        </p>
        <div class="eosolar-grid-12">
          {
            MESI.map((m, i) => (
              <div class="eosolar-field eosolar-field--sm">
                <label for={`eosolar-ore-${i}`}>{m}</label>
                <input id={`eosolar-ore-${i}`} type="number" inputmode="decimal" min="0" step="1" value={DEFAULT_CONSUMI.oreEquivalenti[i]} data-ore={i} />
              </div>
            ))
          }
        </div>
        <div class="eosolar-field eosolar-field--limit">
          <div class="eosolar-field__head">
            <label for="eosolar-kwpmax">Potenza massima installabile (kWp, facoltativa)</label>
            <Info k="kwpMax" label="Potenza massima installabile" />
          </div>
          <input
            id="eosolar-kwpmax"
            type="number"
            inputmode="decimal"
            min={RANGE.kwp.min}
            max={RANGE.kwp.max}
            step="0.5"
            placeholder="Nessun limite"
            data-kwp-max
            aria-describedby="eosolar-kwpmax-help"
          />
          <p id="eosolar-kwpmax-help" class="eosolar-card__sub">
            Se la lasci vuota la ricerca arriva fino a {fmtInt(RANGE.kwp.max)} kWp, entro il limite di produzione rispetto ai consumi.
          </p>
        </div>
      </fieldset>

      <fieldset class="eosolar-card">
        <legend class="eosolar-card__title">Parametri economici</legend>
        <div class="eosolar-params">
          {
            MAIN_FIELDS.map((f) => (
              <div class="eosolar-field">
                <div class="eosolar-field__head">
                  <label for={fieldId(f)}>{f.label} ({f.unit})</label>
                  <Info k={f.key} label={f.label} />
                </div>
                <input id={fieldId(f)} type="number" inputmode="decimal" step={f.step} min={f.min} max={f.max} value={displayValue(f)} data-param={f.key} data-scale={f.scale} />
              </div>
            ))
          }
        </div>
      </fieldset>

      <!-- Parametri avanzati: modificabili solo dopo la password (controllo lato browser, vedi src/lib/eosolar/admin.ts) -->
      <fieldset class="eosolar-card eosolar-admin">
        <legend class="eosolar-card__title">Parametri avanzati</legend>
        <div class="eosolar-admin__bar" data-admin-locked>
          <p><span aria-hidden="true">🔒</span> Costi di riferimento, parametri tecnici e opzioni fiscali sono riservati a EOS.</p>
          <button type="button" class="btn btn--secondary" data-admin-open>Sblocca con password</button>
        </div>
        <div class="eosolar-admin__bar eosolar-admin__bar--open" data-admin-unlocked hidden>
          <p><span aria-hidden="true">🔓</span> Parametri avanzati modificabili per questa sessione.</p>
          <button type="button" class="btn btn--secondary" data-admin-lock>Blocca di nuovo</button>
        </div>

        <details class="eosolar-details">
          <summary>Costi di riferimento (IVA esclusa)</summary>
          <p class="eosolar-card__sub">
            Costo chiavi in mano per kWp o per kWh, interpolato linearmente sulla taglia; oltre l'ultimo punto resta costante.
          </p>
          <div class="eosolar-field eosolar-field--limit">
            <div class="eosolar-field__head">
              <label for="eosolar-cost-fisso">Costo fisso per impianto (€)</label>
              <Info k="fissoImpianto" label="Costo fisso per impianto" />
            </div>
            <input id="eosolar-cost-fisso" type="number" inputmode="decimal" min="0" step="50" value={DEFAULT_COSTI.fissoImpianto} data-cost-fisso data-admin disabled />
          </div>
          <div class="eosolar-grid-2">
            <div class="eosolar-table-wrap">
              <table class="eosolar-table eosolar-table--edit">
                <caption class="visually-hidden">Costo dell'impianto fotovoltaico per taglia</caption>
                <thead>
                  <tr>
                    <th scope="col">Taglia FV <Info k="costiFV" label="Costi del fotovoltaico" /></th>
                    <th scope="col" class="num">€/kWp</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    DEFAULT_COSTI.fv.map((c) => (
                      <tr>
                        <th scope="row"><label for={`eosolar-cost-fv-${c.size}`}>{fmtSize(c.size)} kWp</label></th>
                        <td class="num">
                          <input id={`eosolar-cost-fv-${c.size}`} type="number" inputmode="decimal" min="0" step="10" value={c.unitCost} data-cost="fv" data-size={c.size} data-admin disabled />
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
            <div class="eosolar-table-wrap">
              <table class="eosolar-table eosolar-table--edit">
                <caption class="visually-hidden">Costo della batteria per capacità</caption>
                <thead>
                  <tr>
                    <th scope="col">Batteria <Info k="costiBatteria" label="Costi della batteria" /></th>
                    <th scope="col" class="num">€/kWh</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    DEFAULT_COSTI.batteria.map((c) => (
                      <tr>
                        <th scope="row"><label for={`eosolar-cost-batt-${c.size}`}>{fmtSize(c.size)} kWh</label></th>
                        <td class="num">
                          <input id={`eosolar-cost-batt-${c.size}`} type="number" inputmode="decimal" min="0" step="10" value={c.unitCost} data-cost="batteria" data-size={c.size} data-admin disabled />
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>
        </details>

        <details class="eosolar-details">
          <summary>Parametri tecnici e di manutenzione</summary>
          <div class="eosolar-params">
            {
              ADVANCED_FIELDS.map((f) => (
                <div class="eosolar-field">
                  <div class="eosolar-field__head">
                    <label for={fieldId(f)}>{f.label} ({f.unit})</label>
                    <Info k={f.key} label={f.label} />
                  </div>
                  <input id={fieldId(f)} type="number" inputmode="decimal" step={f.step} min={f.min} max={f.max} value={displayValue(f)} data-param={f.key} data-scale={f.scale} data-admin disabled />
                </div>
              ))
            }
          </div>
        </details>

        <details class="eosolar-details">
          <summary>Vendita energia e agevolazioni fiscali (disattivate)</summary>
          <!-- TODO(EOS): verificare normativa vigente; i default restano disattivati finché non confermati. -->
          <p class="eosolar-card__sub">
            Opzioni disattivate di default: attivale solo con valori verificati sulla normativa vigente.
          </p>
          <div class="eosolar-params">
            <div class="eosolar-toggle">
              <div class="eosolar-check">
                <input id="eosolar-rid-on" type="checkbox" data-toggle="ritiroDedicato" checked={p.ritiroDedicato.attivo} data-admin disabled />
                <label for="eosolar-rid-on">Valorizza l'energia immessa (ritiro dedicato)</label>
                <Info k="ritiroDedicato" label="Valore dell'energia immessa" />
              </div>
              <div class="eosolar-field">
                <label for="eosolar-rid-prezzo">Prezzo energia immessa (€/kWh)</label>
                <input id="eosolar-rid-prezzo" type="number" inputmode="decimal" step="0.01" min="0" value={p.ritiroDedicato.prezzo} data-toggle-value="ritiroDedicato.prezzo" data-scale="1" data-admin disabled />
              </div>
            </div>
            <div class="eosolar-toggle">
              <div class="eosolar-check">
                <input id="eosolar-iva-on" type="checkbox" data-toggle="iva" checked={p.iva.attivo} data-admin disabled />
                <label for="eosolar-iva-on">Applica l'IVA a investimento e costi</label>
                <Info k="iva" label="IVA" />
              </div>
              <div class="eosolar-field">
                <label for="eosolar-iva-aliquota">Aliquota IVA (%)</label>
                <input id="eosolar-iva-aliquota" type="number" inputmode="decimal" step="1" min="0" max="100" value={p.iva.aliquota * 100} data-toggle-value="iva.aliquota" data-scale="0.01" data-admin disabled />
              </div>
            </div>
            <div class="eosolar-toggle">
              <div class="eosolar-check">
                <input id="eosolar-detr-on" type="checkbox" data-toggle="detrazione" checked={p.detrazione.attivo} data-admin disabled />
                <label for="eosolar-detr-on">Considera una detrazione fiscale</label>
                <Info k="detrazione" label="Detrazione fiscale" />
              </div>
              <div class="eosolar-field">
                <label for="eosolar-detr-aliquota">Aliquota detrazione (%)</label>
                <input id="eosolar-detr-aliquota" type="number" inputmode="decimal" step="1" min="0" max="100" value={p.detrazione.aliquota * 100} data-toggle-value="detrazione.aliquota" data-scale="0.01" data-admin disabled />
              </div>
              <div class="eosolar-field">
                <label for="eosolar-detr-anni">Anni di recupero</label>
                <input id="eosolar-detr-anni" type="number" inputmode="numeric" step="1" min="1" max="25" value={p.detrazione.anni} data-toggle-value="detrazione.anni" data-scale="1" data-admin disabled />
              </div>
            </div>
          </div>
        </details>
      </fieldset>

      <div class="eosolar-alert eosolar-alert--error" role="alert" data-input-errors hidden>
        <p><strong>Controlla i dati inseriti:</strong></p>
        <ul data-input-errors-list></ul>
      </div>

      <button type="submit" class="btn btn--primary btn--block">Calcola il dimensionamento ottimale</button>
    </form>
  </div>

  <!-- ============ TAB 2: OTTIMALE ============ -->
  <div role="tabpanel" id="eosolar-panel-ottimale" aria-labelledby="eosolar-tab-ottimale" data-panel="ottimale" tabindex="0" hidden>
    <ResultView variant="opt" />
  </div>

  <!-- ============ TAB 3: MANUALE ============ -->
  <div role="tabpanel" id="eosolar-panel-manuale" aria-labelledby="eosolar-tab-manuale" data-panel="manuale" tabindex="0" hidden>
    <div class="eosolar-card">
      <h3 class="eosolar-card__title">Scegli potenza e accumulo</h3>
      <div class="eosolar-slider">
        <label for="eosolar-slider-kwp">Potenza fotovoltaico</label>
        <input id="eosolar-slider-kwp" type="range" min="0" max={gridKwp.length - 1} step="1" value={startKwp} data-slider="kwp" aria-describedby="eosolar-slider-kwp-out" />
        <output id="eosolar-slider-kwp-out" class="num" for="eosolar-slider-kwp" data-slider-out="kwp">3,0 kWp</output>
      </div>
      <div class="eosolar-slider">
        <label for="eosolar-slider-kwh">Accumulo</label>
        <input id="eosolar-slider-kwh" type="range" min="0" max={gridKwh.length - 1} step="1" value="0" data-slider="kwh" aria-describedby="eosolar-slider-kwh-out" />
        <output id="eosolar-slider-kwh-out" class="num" for="eosolar-slider-kwh" data-slider-out="kwh">0,0 kWh</output>
      </div>
      <p class="eosolar-card__sub">
        I risultati si aggiornano mentre muovi i cursori, con i dati del primo tab. Il passo della potenza cresce con la
        taglia (0,5 kWp fino a 10 kWp, poi 1, 2,5, 5 e 10 kWp) ed è limitato dalla potenza massima installabile.
      </p>
    </div>
    <ResultView variant="man" />
  </div>

  <template data-tpl="li"><li data-f="text"></li></template>
</div>
