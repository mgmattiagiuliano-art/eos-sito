---
/**
 * Guscio comune delle pagine /lab: <head> con noindex, barra fissa della direzione,
 * cavo opzionale. Ogni variante porta i propri token e font nella pagina.
 */
import LabBar from './LabBar.astro';
import LabWire from './LabWire.astro';

interface Props {
  title: string;
  code: string;
  direction: string;
  logic: [string, string, string];
  wire: 'ortho' | 'curve' | 'zigzag' | 'rail';
  themeColor?: string;
}

const { title, code, direction, logic, wire, themeColor = '#0F172A' } = Astro.props;
---

<!doctype html>
<html lang="it" data-wire="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/logo.png" />
    <title>{title} · EOS Lab</title>
  </head>
  <body>
    <LabBar code={code} direction={direction} logic={logic} />
    <LabWire variant={wire} />
    <slot />
    <div class="labtoast" role="status" aria-live="polite"></div>
  </body>
</html>

<script>
  // Nel lab nulla viene inviato: form e pulsanti del calcolatore mostrano solo un avviso.
  const toast = document.querySelector<HTMLElement>('.labtoast');
  let timer = 0;
  function notify(msg: string) {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add('is-on');
    clearTimeout(timer);
    timer = window.setTimeout(() => toast.classList.remove('is-on'), 3200);
  }
  document.addEventListener('click', (e) => {
    const el = (e.target as Element | null)?.closest<HTMLElement>('[data-demo]');
    if (!el) return;
    e.preventDefault();
    notify(el.dataset.demo || 'Anteprima di design: funzione non collegata nel lab.');
  });
  document.addEventListener('submit', (e) => {
    const form = e.target as HTMLFormElement;
    if (!form.matches('[data-demo-form]')) return;
    e.preventDefault();
    notify('Anteprima di design: nel lab il modulo non invia dati.');
  });
</script>

<style is:global>
  :root {
    --labbar-h: 44px;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    padding-top: var(--labbar-h);
    position: relative;
    overflow-x: clip;
  }
  img {
    max-width: 100%;
    display: block;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .labtoast {
    position: fixed;
    left: 50%;
    bottom: 16px;
    z-index: 1001;
    max-width: calc(100% - 32px);
    transform: translate(-50%, 150%);
    padding: 10px 16px;
    border-radius: 8px;
    background: #0b1020;
    color: #fff;
    font: 500 14px/1.4 system-ui, sans-serif;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition: transform 0.3s ease;
  }
  .labtoast.is-on {
    transform: translate(-50%, 0);
  }
  .labtoast:empty {
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto !important;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>
