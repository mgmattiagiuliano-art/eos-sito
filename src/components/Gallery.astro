---
import { Picture, getImage } from 'astro:assets';
import { gallery } from '../data/gallery';
import Lightbox from './Lightbox.astro';

// Versioni grandi per la lightbox (generate al build, caricate solo all'apertura)
const large = await Promise.all(
  gallery.map(async (g) => {
    const img = await getImage({ src: g.image, width: 1600, format: 'webp', quality: 75 });
    return { src: img.src, width: Number(img.attributes.width), height: Number(img.attributes.height), alt: g.alt };
  }),
);
---

<section class="section container" id="lavori" aria-labelledby="lavori-title">
  <div class="section-head">
    <h2 id="lavori-title">I nostri <span class="spark">lavori realizzati</span></h2>
    <p>Seleziona una foto per ingrandirla.</p>
  </div>

  <ul class="fotowall" role="list">
    {
      gallery.map((g, i) => (
        <li class:list={['fotowall__item', 'reveal', `fotowall__item--${g.area}`]}>
          <button type="button" class="fotowall__btn" data-gallery-open={i} aria-label={`Ingrandisci: ${g.alt}`}>
            <Picture
              src={g.image}
              alt=""
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              quality={70}
              widths={[360, 600, 900]}
              sizes="(min-width: 900px) 50vw, 100vw"
              class="fotowall__img"
              loading="lazy"
              decoding="async"
            />
          </button>
        </li>
      ))
    }
  </ul>
</section>

<Lightbox images={large} />

<style>
  .fotowall {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: 220px;
    gap: 18px;
  }

  @media (min-width: 560px) {
    .fotowall {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 180px;
    }

    /* 2 colonne: una alta + una larga + sei singole = 5 righe piene (dense riempie i vuoti) */
    .fotowall {
      grid-auto-flow: dense;
    }

    .fotowall__item--a {
      grid-row: span 2;
    }

    .fotowall__item--h {
      grid-column: span 2;
    }
  }

  /* Mosaico desktop 4×2: due verticali alte, una orizzontale larga, due piccole */
  @media (min-width: 900px) {
    .fotowall {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas:
        'a b b c'
        'a d e c'
        'f h h g'
        'f h h g';
      grid-auto-rows: 210px;
    }

    .fotowall__item--a,
    .fotowall__item--c,
    .fotowall__item--f,
    .fotowall__item--g,
    .fotowall__item--h {
      grid-row: auto;
      grid-column: auto;
    }

    .fotowall__item--a { grid-area: a; }
    .fotowall__item--b { grid-area: b; }
    .fotowall__item--c { grid-area: c; }
    .fotowall__item--d { grid-area: d; }
    .fotowall__item--e { grid-area: e; }
    .fotowall__item--f { grid-area: f; }
    .fotowall__item--g { grid-area: g; }
    .fotowall__item--h { grid-area: h; }
  }

  .fotowall__item {
    min-width: 0;
  }

  .fotowall__btn {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    background: var(--c-border);
    box-shadow: 0 4px 10px rgb(0 0 0 / 0.03);
    cursor: zoom-in;
    transition:
      transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1),
      box-shadow 0.4s ease,
      border-color 0.4s ease;
  }

  .fotowall__btn :global(.fotowall__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .fotowall__btn:hover,
  .fotowall__btn:focus-visible {
    border-color: var(--c-blue);
    box-shadow: 0 15px 30px rgb(0 0 0 / 0.12);
  }

  @media (prefers-reduced-motion: no-preference) {
    .fotowall__btn:hover {
      transform: scale(1.02) translateY(-4px);
    }

    .fotowall__btn:hover :global(.fotowall__img) {
      transform: scale(1.06);
    }
  }
</style>
