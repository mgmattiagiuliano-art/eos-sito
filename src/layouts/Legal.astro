---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  /** Data di ultimo aggiornamento del testo (TODO(EOS) finché non è validato). */
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<Base title={title} description={description}>
  <article class="legal container">
    <p class="legal__back"><a href="/">← Torna alla home</a></p>
    <h1>{title}</h1>
    <p class="legal__updated">Ultimo aggiornamento: {updated}</p>
    <slot />
  </article>
</Base>

<style>
  .legal {
    max-width: calc(820px + 2 * var(--gutter));
    padding-block: 48px 80px;
  }

  .legal__back {
    margin-bottom: 24px;
    font-size: 0.9rem;
  }

  .legal h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin-bottom: 8px;
  }

  .legal__updated {
    margin-bottom: 32px;
    font-size: 0.85rem;
    color: var(--c-text-muted);
  }

  .legal :global(h2) {
    margin: 36px 0 12px;
    font-size: 1.3rem;
  }

  .legal :global(h3) {
    margin: 20px 0 8px;
    font-size: 1.05rem;
  }

  .legal :global(p),
  .legal :global(ul),
  .legal :global(table) {
    margin-bottom: 14px;
  }

  .legal :global(ul) {
    padding-left: 1.3em;
  }

  .legal :global(li) {
    margin-bottom: 6px;
  }

  .legal :global(.table-wrap) {
    overflow-x: auto;
  }

  .legal :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .legal :global(th),
  .legal :global(td) {
    padding: 10px;
    border: 1px solid var(--c-border);
    text-align: left;
    vertical-align: top;
  }

  .legal :global(th) {
    background: var(--c-bg);
    color: var(--c-ink);
  }

  .legal :global(.todo) {
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--c-warn-bg);
    color: var(--c-warn-text);
    font-weight: 600;
  }
</style>
