<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    // Motto: le righe salgono come una quota che si scrive.
    gsap.from('.a-motto .a-line > span', {
      yPercent: 110,
      duration: 0.9,
      ease: 'power3.out',
      stagger: 0.12,
      delay: 0.15,
    });

    // Righe di tavola: il tratto si estende da sinistra.
    gsap.utils.toArray<HTMLElement>('.a-rule').forEach((rule) => {
      gsap.from(rule, {
        scaleX: 0,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: { trigger: rule, start: 'top 90%' },
      });
    });

    // Blocchi: comparsa asciutta, piccolo spostamento.
    gsap.utils.toArray<HTMLElement>('.a-reveal').forEach((el) => {
      gsap.from(el, {
        autoAlpha: 0,
        y: 16,
        duration: 0.6,
        ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 88%' },
      });
    });

    // Schema unifilare: ogni tratto si disegna in sequenza.
    const paths = gsap.utils.toArray<SVGGeometryElement>('.a-diagram .a-draw');
    paths.forEach((p) => {
      const len = p.getTotalLength();
      gsap.set(p, { strokeDasharray: len, strokeDashoffset: len });
    });
    gsap.set('.a-diagram .a-flow, .a-diagram text', { autoAlpha: 0 });
    const tl = gsap.timeline({ scrollTrigger: { trigger: '.a-diagram', start: 'top 75%' } });
    tl.to(paths, { strokeDashoffset: 0, duration: 0.7, ease: 'power1.inOut', stagger: 0.06 })
      .to('.a-diagram text', { autoAlpha: 1, duration: 0.4, stagger: 0.03 }, '-=0.6')
      .to('.a-diagram .a-flow', { autoAlpha: 1, duration: 0.4 });

    // Targa dati: le cifre "si misurano".
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const raw = el.dataset.count ?? '';
      const m = raw.match(/^(\d+)(.*)$/);
      if (!m) return;
      const target = Number(m[1]);
      const suffix = m[2];
      const obj = { v: 0 };
      el.textContent = `0${suffix}`;
      gsap.to(obj, {
        v: target,
        duration: 1.2,
        ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 85%' },
        onUpdate: () => {
          el.textContent = `${Math.round(obj.v)}${suffix}`;
        },
      });
    });
  });
</script>
